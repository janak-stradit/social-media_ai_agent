{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediaBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::S3_MEDIA_BUCKET/uploads/*"
    },
    {
      "Sid": "MediaBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::S3_MEDIA_BUCKET"
    }
  ]
}
