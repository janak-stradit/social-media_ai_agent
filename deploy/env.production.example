# Template for the ENV_FILE GitHub secret (one per GitHub Environment).
# Copy this, fill in the values, and paste the WHOLE text as the secret value.
# Never commit the filled-in version. Lines you don't use can be deleted.

# --- Core (required) --------------------------------------------------------
SECRET_KEY=<64+ random chars: python -c "import secrets;print(secrets.token_hex(48))">
DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@<rds-endpoint>.rds.amazonaws.com:5432/<db_name>?sslmode=require
APP_BASE_URL=https://<your-domain>
USE_MOCK_LLM=false
CAPTCHA_ENABLED=true

# --- HeyRoute (LLM / image / video) ----------------------------------------
HEYROUTE_API_KEY=
HEYROUTE_IMAGE_API_KEY=
HEYROUTE_VIDEO_API_KEY=
HEYROUTE_LLM_MODEL=gpt-5.6-terra
HEYROUTE_REASONING_EFFORT=low
HEYROUTE_IMAGE_MODEL=gemini-3-pro-image
HEYROUTE_VIDEO_MODEL=grok-video

# --- Other providers (only if used) ----------------------------------------
KIE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
HF_API_TOKEN=

# --- Email (approval notifications, password reset) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
APPROVAL_NOTIFY_EMAIL=
SALES_EMAIL=

# --- AWS (S3 / Bedrock) -----------------------------------------------------
# Do NOT set AWS_PROFILE on EC2 - there is no ~/.aws profile there and boto3
# would fail. Prefer an EC2 IAM role (then leave both keys empty too).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_BUCKET_OWNER=

# --- S3 storage for generated content + uploads ------------------------------
# Every generated image/video and user upload is copied here; files missing on
# the server's disk are restored from it. Empty = disabled.
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=uploads

# --- Social platform OAuth ---------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
