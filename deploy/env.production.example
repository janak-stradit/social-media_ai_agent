# Template for the ENV_FILE GitHub secret (one per GitHub Environment).
# Fill in the values and paste the WHOLE text as the secret value.
# Never commit the filled-in version. Delete lines you don't use.
# Format: KEY=value, one per line, no spaces around "=". Quote values that contain
# spaces or "#", e.g. SMTP_PASSWORD="p@ss #1".
#
# Not needed here (set by deploy/docker-compose.prod.yml): SCHEDULER_ENABLED,
# WEB_CONCURRENCY, REDIS_URL. Never add AWS_PROFILE (no AWS profiles on the server).

# === REQUIRED ================================================================
# New random value for production: python -c "import secrets;print(secrets.token_hex(48))"
SECRET_KEY=
# RDS endpoint from Step 2 (URL-encode special characters in the password)
DATABASE_URL=postgresql+psycopg2://smadmin:<password>@<rds-endpoint>:5432/socialmedia?sslmode=require
# Public address of the site - used for links in emails
APP_BASE_URL=https://<your-domain>
USE_MOCK_LLM=false

# --- Facebook / Instagram publishing (docs/instagram-publishing.md) -----------
# Meta Graph API version - Meta retires each one about two years after release
META_GRAPH_VERSION=v23.0
# Only if post images are served from another public HTTPS address than APP_BASE_URL
# PUBLIC_MEDIA_BASE_URL=https://<your-domain>

# --- Logging (logging_setup.py) ----------------------------------------------
# text = readable in `docker logs`; json = one JSON object per line for
# CloudWatch / Datadog / ELK. DEBUG also shows static files and health checks.
LOG_FORMAT=text
LOG_LEVEL=INFO

# --- HeyRoute: LLM (all text), images, video ---------------------------------
HEYROUTE_API_KEY=
HEYROUTE_IMAGE_API_KEY=
HEYROUTE_VIDEO_API_KEY=
HEYROUTE_LLM_MODEL=gpt-5.6-terra
# low = faster + cheaper generations (medium can exceed the 120 s LLM timeout)
HEYROUTE_REASONING_EFFORT=low
# Must be an IMAGE model enabled for the image key's group. Flash costs far less
# than gemini-3-pro-image (which this key's group doesn't include anyway).
HEYROUTE_IMAGE_MODEL=gemini-3.1-flash-image
# What HeyRoute charges per image - check the HeyRoute dashboard and set it, so
# image costs count against each user's credit limit.
HEYROUTE_IMAGE_COST_USD=0.55
HEYROUTE_VIDEO_MODEL=minimax-h3-original-768p
# Clip length in seconds (15 is the most any model gives; cost = seconds x the price below)
HEYROUTE_VIDEO_SECONDS=15
# What HeyRoute charges per second of video (0.70 = minimax-h3-original-768p) - change it
# with the model, so video costs count against each user's credit limit.
HEYROUTE_VIDEO_COST_PER_SECOND_USD=0.70

# --- Email (verification, password reset, approvals) -------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
APPROVAL_NOTIFY_EMAIL=
SALES_EMAIL=

# Image analysis (uploaded photos) - one call on the HeyRoute text key.
# Must be a model that accepts images; defaults to HEYROUTE_LLM_MODEL.
VISION_PROVIDER=heyroute
HEYROUTE_VISION_MODEL=gpt-5.6-terra

# --- AWS: S3 storage for generated content -----------------------------------
AWS_REGION=us-east-1
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=uploads
# Leave both EMPTY when the EC2 instance has the avir-ec2 IAM role (recommended).
# Only fill them if you don't use the role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === OPTIONAL - only for features you use ====================================
# Competitor scraper service
SCRAPER_API_URL=
SCRAPER_API_KEY=
# YouTube publishing (OAuth app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Other providers - not used for text/image/video while the HeyRoute keys are set
HF_API_TOKEN=
GOOGLE_API_KEY=
# Video voiceover (needs GOOGLE_API_KEY; falls back to the robotic gTTS voice without it)
# VOICEOVER_TTS_MODEL=gemini-2.5-flash-preview-tts
# VOICEOVER_VOICE=Sulafat
# Weekly ideas email: three post ideas per user, once a week. Off until set to true.
# Needs SMTP_* and APP_BASE_URL. Day 0 = Monday; the hour is UTC.
WEEKLY_IDEAS_EMAIL=false
# IDEAS_EMAIL_WEEKDAY=0
# IDEAS_EMAIL_HOUR_UTC=4
# Timely nudges (occasion coming up, trending topic, reminder after a quiet spell). They always show
# under the header bell; true also emails them (max IDEA_EMAILS_PER_WEEK idea emails per user, weekly one included).
NUDGE_EMAILS=false
# NUDGE_OCCASION_DAYS=5
# NUDGE_INACTIVE_DAYS=10
# IDEA_EMAILS_PER_WEEK=2
# Monthly recap email: last month's posts and what to try next, sent from day RECAP_EMAIL_DAY
# to users who posted that month. Off until set to true.
MONTHLY_RECAP_EMAIL=false
# RECAP_EMAIL_DAY=1
OPENAI_API_KEY=
OPENROUTER_API_KEY=
Z_AI_API_KEY=
